# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment variables (never commit secrets)
.env
backend/.env
frontend/.env

# Python (in case anything gets accidentally created again)
.venv/
venv/
__pycache__/
*.pyc

# Build output
dist/
frontend/dist/
build/

# Uploaded media files (don't commit user uploads)
uploads/
backend/uploads/

# Logs
*.log
npm-debug.log*

# OS-generated files
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/